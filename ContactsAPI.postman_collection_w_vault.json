		{
			"name": "GetAllContacts",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"var template = `",
							"<div style=\"font-family: Arial, sans-serif; padding: 20px;\">",
							"    <h2 style=\"text-align: center; color: #333;\">Contacts List</h2>",
							"    <table style=\"width: 100%; border-collapse: collapse; margin-top: 10px;\">",
							"        <thead>",
							"            <tr style=\"background-color: #4CAF50; color: white;\">",
							"                <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd;\">First Name</th>",
							"                <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd;\">Last Name</th>",
							"                <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd;\">Email</th>",
							"                <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd;\">Phone</th>",
							"                <th style=\"padding: 12px; text-align: left; border: 1px solid #ddd;\">Country</th>",
							"            </tr>",
							"        </thead>",
							"        <tbody>",
							"            {{#each contacts}}",
							"            <tr style=\"background-color: {{rowColor}};\">",
							"                <td style=\"padding: 10px; border: 1px solid #ddd;\">{{firstName}}</td>",
							"                <td style=\"padding: 10px; border: 1px solid #ddd;\">{{lastName}}</td>",
							"                <td style=\"padding: 10px; border: 1px solid #ddd;\">{{email}}</td>",
							"                <td style=\"padding: 10px; border: 1px solid #ddd;\">{{phone}}</td>",
							"                <td style=\"padding: 10px; border: 1px solid #ddd;\">{{country}}</td>",
							"            </tr>",
							"            {{/each}}",
							"        </tbody>",
							"    </table>",
							"</div>",
							"`;",
							"",
							"function constructVisualizerPayload() {",
							"    var response = pm.response.json();",
							"    var contacts = response.map(function(contact, index) {",
							"        return {",
							"            firstName: contact.firstName || '',",
							"            lastName: contact.lastName || '',",
							"            email: contact.email || '',",
							"            phone: contact.phone || '',",
							"            country: contact.country || 'Unknown',",
							"            rowColor: index % 2 === 0 ? '#f9f9f9' : '#ffffff'",
							"        };",
							"    });",
							"    return { contacts: contacts };",
							"}",
							"",
							"pm.visualizer.set(template, constructVisualizerPayload());"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "{{vault:contacts authorization token}}",
						"type": "text"
					}
				],
				"url": {
