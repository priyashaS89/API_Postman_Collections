						"key": "Authorization",
						"value": "{{tokenID}}",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\r\n    \"status\": \"inactive\"\r\n}"
				},
				"url": {
					"raw": "{{baseURL}}/public/v2/users/{{userID}}",
